NODE_ENV=development
PORT=5000
ALLOWED_ORIGINS=http://localhost:3000

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
CRM_OWNER_EMAILS=
CRM_STAFF_EMAILS=

CRON_SECRET=
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_VERSION=v25.0
META_WA_PHONE_NUMBER_ID=
META_WA_WABA_ID=
META_WA_ACCESS_TOKEN=
# Approved Meta template name for POS payment links (default: payment_link)
WA_PAYMENT_TEMPLATE=payment_link
INSTAGRAM_APP_SECRET=
INSTAGRAM_ACCESS_TOKEN=
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=

ICOUNT_API_TOKEN=
ICOUNT_WEBHOOK_SECRET=
# iCount payment page id from paypage/get_list (default: 45 = אימון הכירות)
ICOUNT_PAY_PAGE_ID=45
# Or set a full page URL (overrides id/slug resolution):
# ICOUNT_PAY_PAGE_URL=https://app.icount.co.il/m/9a79f
# Dedicated events page (recommended). Create a generic page titled e.g. "תשלום לאירוע"
# so birthday / camp / company events do not inherit the intro-training title.
# ICOUNT_EVENT_PAY_PAGE_URL=https://app.icount.co.il/m/YOUR_EVENT_PAGE
# ICOUNT_PAY_PAGE=45
# Deep links into the iCount interface, shown in the payments folder of the
# customer file — used for work the API cannot do, such as a partial credit.
# Leave unset and the buttons simply do not appear.
ICOUNT_CLIENT_URL_TEMPLATE=https://app.icount.co.il/reports/fullclient.php?id={clientId}
ICOUNT_DOC_URL_TEMPLATE=https://app.icount.co.il/hash/show_doc.php?doctype={doctype}&docnum={docnum}

# Optional override for public API base (short /r/ redirects + IPN callbacks).
# Local: http://localhost:5001  |  Live: https://climbing-crm-api.onrender.com
# If unset: localhost in local/dev, live API when NODE_ENV=production.
# PUBLIC_API_URL=http://localhost:5001
# PUBLIC_API_URL=https://climbing-crm-api.onrender.com

# Optional: confirmation emails for activity registrations (Resend)
# RESEND_API_KEY=
# EMAIL_FROM=קיר בועז <noreply@yourdomain.com>

GEMINI_API_KEY=

# העוזר החכם (הצעות משימה מתוך שיחות) נשלט ממסך "עוזר חכם" בתוך המערכת.
# המשתנה כאן הוא מתג-הרג לסביבה בלבד:
#   false = שום ניתוח אוטומטי בסביבה הזאת, גם אם הוא דלוק במסך.
#   לא מוגדר / true = המסך מחליט.
# בכל מקרה שום הצעה לא נכנסת ל-CRM לפני אישור של הצוות.
# AI_SUGGESTIONS_ENABLED=false

# Google Calendar (יומן sync) — OAuth Web client
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Local (port must match the running API):
# GOOGLE_REDIRECT_URI=http://localhost:5001/api/google-calendar/oauth/callback
# Production:
# GOOGLE_REDIRECT_URI=https://climbing-crm-api.onrender.com/api/google-calendar/oauth/callback
GOOGLE_REDIRECT_URI=
# Public frontend origin for host registration / WhatsApp links (not localhost on phones)
# FRONTEND_URL=https://client-omega-topaz-35.vercel.app
# PUBLIC_APP_URL=https://client-omega-topaz-35.vercel.app
