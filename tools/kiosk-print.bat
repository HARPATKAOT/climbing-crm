@echo off
REM ---------------------------------------------------------------------------
REM  מסוף הכניסה — הפעלה עם הדפסה שקטה
REM
REM  --kiosk-printing אומר לכרום להדפיס ישירות למדפסת ברירת המחדל בלי חלונית
REM  אישור. זו הדרך היחידה להדפסה אוטומטית מדפדפן, ולכן המסוף חייב להיפתח
REM  מהקיצור הזה ולא מכרום רגיל.
REM
REM  לפני השימוש: להגדיר את המדפסת התרמית כמדפסת ברירת המחדל בווינדוס,
REM  ובהגדרות הדרייבר שלה לסמן פתיחת מגירה בסוף ההדפסה.
REM ---------------------------------------------------------------------------
start "" "%ProgramFiles%\Google\Chrome\Application\chrome.exe" ^
  --kiosk-printing ^
  --user-data-dir="%LOCALAPPDATA%\KirBoazTerminal" ^
  https://app.kirboaz.co.il/checkin
